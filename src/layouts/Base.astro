---
import '../styles/site.css'
import '../styles/libraries.css'
import { libraries } from '../data/libraries.js'
import { author } from '../data/author.js'
import { to, home } from '../data/paths.js'

interface Props { title: string; description: string; path?: string[]; schema?: Record<string, unknown>[] }
const { title, description, path = [], schema = [] } = Astro.props
const here = Astro.url.pathname.slice(to('').length).replace(/\/$/, '') || '/'
const nav = [['libraries', '/docs/ink'], ['docs', '/docs'], ['changelog', '/changelog']]
const active = (href: string) => (href === '/docs' ? here === '/docs' || here === '/docs/install' : href === '/docs/ink' ? libraries.some(l => here === `/docs/${l.slug}`) : here === href)
const pages = [
  { title: 'Introduction', href: '/docs', line: 'What proof is and how the libraries work.' },
  { title: 'Install', href: '/docs/install', line: 'Copy one file. No package, no build step.' },
  ...libraries.map(l => ({ title: l.slug, href: `/docs/${l.slug}`, line: l.line, terms: [l.call, ...l.options, ...l.returns, ...(l.extra || [])].map(r => (Array.isArray(r) ? r[0] : r)).join(' ') })),
  { title: 'Changelog', href: '/changelog', line: 'What changed and when.' },
]
// one graph per page: the author is a stable @id, so every page and library points at the same person
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': author.id, name: author.name, url: author.url, sameAs: author.sameAs },
    { '@type': 'WebSite', '@id': `${home}#website`, name: 'proof', url: home, description: 'Dependency-free JavaScript libraries for print, sound and text effects on the web.', author: { '@id': author.id }, publisher: { '@id': author.id }, license: 'https://opensource.org/licenses/MIT' },
    ...schema,
  ],
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="proof">
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={new URL(to('/og.png'), Astro.site)}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="author" content={author.name}>
<link rel="author" href={author.url}>
<link rel="alternate" type="text/plain" href={to('/llms.txt')} title="llms.txt">
<link rel="icon" href={to('/favicon.svg')} type="image/svg+xml">
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
<link rel="preload" href={to('/fonts/DepartureMono-Regular.woff2')} as="font" type="font/woff2" crossorigin>
<script is:inline>
  // set before first paint so a saved theme never flashes the other one
  try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t } catch {}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap">
    <a class="path" href={to('/')} aria-label="proof home"><b>proof/</b>{path.map((p, i) => <span class={i === path.length - 1 ? 'cur' : ''}>{p}{i < path.length - 1 ? '/' : ''}</span>)}</a>
    <nav class="links" aria-label="Main">
      {nav.map(([label, href]) => <a href={to(href)} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <button type="button" class="kbtn" data-search-open aria-label="Search the docs"><i class="ic" aria-hidden="true">&#xF002;</i><span class="k-label">search</span><kbd>⌘K</kbd></button>
    <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch between light and dark"><i class="ic" data-theme-icon="light" aria-hidden="true">&#xF186;</i><i class="ic" data-theme-icon="dark" aria-hidden="true">&#xF185;</i></button>
  </div>
</header>

<main id="main"><slot /></main>

<footer class="foot">
  <div class="wrap">
    <p>Built by <a href={author.url} rel="me author">{author.name}</a>. Free and open source under the MIT license. Type: Departure Mono by Helena Zhang, Atkinson Hyperlegible Next by the Braille Institute, Basteleur and Ouroboros from Velvetyne, Redaction by Jeremy Mickel and Forest Young, Martian Mono by Evil Martians, jgs by Adel Faure. All SIL Open Font License.</p>
    <nav aria-label="Footer">
      <a href={to('/docs')}>docs</a>
      <a href={to('/changelog')}>changelog</a>
      <a href={to('/llms.txt')}>llms.txt</a>
      <a href={author.repo}>github</a>
    </nav>
  </div>
</footer>

<dialog class="search" data-search aria-label="Search the docs">
  <input type="search" placeholder="Search libraries, options and methods" aria-label="Search" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-list">
  <ul id="search-list" role="listbox" aria-label="Results">
    {pages.map((p, i) => <li role="none"><a id={`hit-${i}`} href={to(p.href)} role="option" aria-selected="false" data-q={`${p.title} ${p.line} ${'terms' in p ? p.terms : ''}`.toLowerCase()}>{p.title}<span>{p.line}</span></a></li>)}
  </ul>
  <p class="empty" hidden>Nothing matches. Try a library name such as ink or dial.</p>
  <footer><span>↑↓ move</span><span>enter open</span><span>esc close</span></footer>
</dialog>

<script>
  import { rules } from '../lib/ascii.js'
  rules()

  const root = document.documentElement
  document.querySelector('[data-theme-toggle]')!.addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
    root.dataset.theme = dark ? 'light' : 'dark'
    try { localStorage.setItem('theme', root.dataset.theme) } catch {}
  })

  const dlg = document.querySelector<HTMLDialogElement>('[data-search]')!
  const input = dlg.querySelector('input')!
  const empty = dlg.querySelector<HTMLElement>('.empty')!
  const items = [...dlg.querySelectorAll<HTMLAnchorElement>('a[data-q]')]
  let shown = items, pick = 0
  const select = (i: number) => {
    pick = (i + shown.length) % Math.max(1, shown.length)
    items.forEach(a => a.setAttribute('aria-selected', 'false'))
    shown[pick]?.setAttribute('aria-selected', 'true')
    shown[pick]?.scrollIntoView({ block: 'nearest' })
    if (shown[pick]) input.setAttribute('aria-activedescendant', shown[pick].id)
    else input.removeAttribute('aria-activedescendant')
  }
  // the index is a dozen local rows, so filtering runs on every keystroke with nothing to debounce
  const filter = () => {
    const words = input.value.trim().toLowerCase().split(/\s+/)
    shown = items.filter(a => { const hit = words.every(w => a.dataset.q!.includes(w)); a.parentElement!.hidden = !hit; return hit })
    empty.hidden = shown.length > 0
    input.setAttribute('aria-expanded', String(shown.length > 0))
    select(0)
  }
  const open = () => { if (!dlg.open) { dlg.showModal(); input.select(); filter() } }
  document.querySelectorAll('[data-search-open]').forEach(b => b.addEventListener('click', open))
  addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : open() }
    else if (e.key === '/' && !dlg.open && !(e.target as HTMLElement).closest('input, textarea, [contenteditable]')) { e.preventDefault(); open() }
  })
  input.addEventListener('input', filter)
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(pick + 1) }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(pick - 1) }
    else if (e.key === 'Enter' && shown[pick]) { e.preventDefault(); location.href = shown[pick].href }
  })
  // a click on the backdrop lands on the dialog element itself, outside its content box
  dlg.addEventListener('pointerdown', e => { if (e.target === dlg) dlg.close() })
</script>
</body>
</html>
